{{define "notice"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;margin:0 auto;">
<tr><td>
<p style="margin:0 0 16px;">{{.Lead}}</p>
{{- if .Items}}
<ul style="margin:0 0 16px;padding-left:20px;">
{{- range .Items}}
<li>{{.}}</li>
{{- end}}
</ul>
{{- end}}
{{- if .Note}}
<p style="margin:0 0 16px;">{{.Note}}</p>
{{- end}}
<p style="margin:0 0 16px;"><a href="{{.URL}}">{{.Action}}</a></p>
<p style="margin:0;font-size:14px;opacity:0.7;">You get this email because of your <a href="{{.SettingsURL}}">notification settings</a>.</p>
</td></tr>
</table>
</body>
</html>
{{end}}
