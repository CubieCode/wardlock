# Wardlock on a VPS (docs/DEPLOYMENT.md, "VPS with automatic TLS and R2").
# Copy to wardlock.env beside compose.yaml, replace every placeholder, and
# `chmod 600 wardlock.env`. Never commit it. Listen addresses and the data
# directory are set in compose.yaml. Every variable is described in
# .env.example and docs/DEPLOYMENT.md.

# Server key: `openssl rand -base64 32 | tr '+/' '-_'`. It is not in the
# backups: store a copy off the server (docs/DEPLOYMENT.md, "Backups and
# restore on the VPS").
WARDLOCK_SECRET=<server key>

# Hosts: sites at <name>.example-sites.net, the dashboard on its own domain.
WARDLOCK_BASE_DOMAIN=example-sites.net
WARDLOCK_DASHBOARD_HOST=wardlock.example.com

# Automatic TLS: the *.example-sites.net wildcard through DNS-01 with a
# Cloudflare API token limited to DNS edit on that zone; the dashboard and
# owners' custom domains through HTTP-01 or TLS-ALPN-01.
WARDLOCK_TLS_MODE=auto
WARDLOCK_DNS_PROVIDER=cloudflare
WARDLOCK_DNS_API_TOKEN=<cloudflare api token>
WARDLOCK_ACME_EMAIL=ops@example.com
# For a first try, the Let's Encrypt staging CA; remove the line afterwards.
# WARDLOCK_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Deploy files in a private R2 bucket, with an R2 API token (Object Read &
# Write) limited to that bucket.
WARDLOCK_BLOB_BACKEND=s3
WARDLOCK_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
WARDLOCK_S3_BUCKET=wardlock-blobs
WARDLOCK_S3_REGION=auto
WARDLOCK_S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=<r2 access key id>
AWS_SECRET_ACCESS_KEY=<r2 secret access key>

# Fewer requests to R2: keep local copies of served files (2 GiB here; size
# it to the files visitors fetch most) and collect garbage once a day.
WARDLOCK_BLOB_CACHE_DIR=/data/blob-cache
WARDLOCK_BLOB_CACHE_MAX_BYTES=2147483648
WARDLOCK_GC_INTERVAL_MINUTES=1440

# Outgoing mail for sign-in and email codes: smtps:// (465) or smtp:// with
# STARTTLS (587). Percent-encode special characters in the user and password.
WARDLOCK_SMTP_URL=smtps://<user>:<password>@smtp.example.com:465
WARDLOCK_SMTP_FROM="Wardlock <no-reply@example.com>"

# Operator controls (docs/DEPLOYMENT.md, "Operator controls"). Abuse reports
# from visitors go to this address; leave it empty to turn reports off. Set
# WARDLOCK_INVITES=operator so only `wardlockd admin create` adds owners.
WARDLOCK_ABUSE_EMAIL=abuse@example.com
# WARDLOCK_INVITES=operator

# Owner quotas (docs/DEPLOYMENT.md, "Owner quotas"): bytes stored (5 GiB),
# sites and deploys in any 24 hours per owner; 0 is unlimited. Give one
# owner more with `wardlockd admin quota ADDRESS --storage 20GiB`.
WARDLOCK_MAX_OWNER_STORAGE=5368709120
WARDLOCK_MAX_OWNER_SITES=25
WARDLOCK_MAX_OWNER_DEPLOYS_PER_DAY=200
# Each team has those quotas of its own, so limit how many one owner starts.
WARDLOCK_QUOTA_TEAMS=5
# Video files are limited to 10 MiB each by default (0 refuses them). To
# refuse executables and installers, uncomment the suggested blocklist.
# WARDLOCK_MAX_VIDEO_SIZE=10485760
# WARDLOCK_BLOCKED_EXTENSIONS=exe,msi,msix,appx,scr,bat,cmd,ps1,vbs,jar,apk,dmg,pkg,deb,rpm,appimage

# Optional content screening (docs/DEPLOYMENT.md, "Content screening"): each
# unique image and page's text is sent once to OpenAI's moderation endpoint
# after activation; sexual content is withheld and anything else flagged is
# emailed to WARDLOCK_ABUSE_EMAIL for review. Read SECURITY-MODEL "Content
# screening" first. Exempt a trusted owner with
# `wardlockd admin moderation disable --owner ADDRESS`.
# WARDLOCK_MODERATION=openai
# WARDLOCK_OPENAI_API_KEY=<OpenAI API key>
# WARDLOCK_MODERATION_QUARANTINE=sexual/minors,sexual

# Optional OAuth and OIDC sign-in for protected sites. Register
# https://auth.example-sites.net/callback/<github|google|oidc> with each
# provider; a provider is on when its client ID and secret are both set.
WARDLOCK_GITHUB_CLIENT_ID=
WARDLOCK_GITHUB_CLIENT_SECRET=
WARDLOCK_GOOGLE_CLIENT_ID=
WARDLOCK_GOOGLE_CLIENT_SECRET=
WARDLOCK_OIDC_ISSUER=
WARDLOCK_OIDC_CLIENT_ID=
WARDLOCK_OIDC_CLIENT_SECRET=
WARDLOCK_OIDC_NAME=
