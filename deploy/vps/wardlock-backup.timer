#
# Starts wardlock-backup.service every night. Enable with
# `systemctl enable --now wardlock-backup.timer`.
[Unit]
Description=Nightly Wardlock backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
