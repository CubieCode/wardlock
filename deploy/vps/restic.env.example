# restic settings for backup.sh (docs/DEPLOYMENT.md, "Backups and restore on
# the VPS"). Copy to /etc/wardlock/restic.env, replace the placeholders and
# `chmod 600` it. The repository is a second R2 bucket, separate from the
# deploy files, with its own R2 API token (Object Read & Write) limited to it.
RESTIC_REPOSITORY=s3:https://<account id>.r2.cloudflarestorage.com/wardlock-backups
# The repository password, one line, mode 0600. Without it the backups cannot
# be read: store a copy off the server with WARDLOCK_SECRET.
RESTIC_PASSWORD_FILE=/etc/wardlock/restic-password
AWS_ACCESS_KEY_ID=<r2 access key id>
AWS_SECRET_ACCESS_KEY=<r2 secret access key>
AWS_DEFAULT_REGION=auto
