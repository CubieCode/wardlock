#
# nginx terminating TLS in front of wardlockd in proxy mode (docs/DEPLOYMENT.md).
# Run wardlockd with WARDLOCK_TLS_MODE=proxy and WARDLOCK_TRUSTED_PROXIES=127.0.0.1,::1.
# Replace the domains and certificate paths.

# Log the path only: query strings carry share-link tokens.
log_format wardlock '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 443 ssl;
    http2 on;
    server_name wardlock.example.com *.example-sites.net;

    ssl_certificate     /etc/ssl/wardlock/fullchain.pem;
    ssl_certificate_key /etc/ssl/wardlock/privkey.pem;

    access_log /var/log/nginx/wardlock.log wardlock;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Protected responses are private; never cache them here.
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
    }
}

server {
    listen 80;
    server_name wardlock.example.com *.example-sites.net;
    return 301 https://$host$request_uri;
}
