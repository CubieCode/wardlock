{
  "name": "wardlock",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo build && bash scripts/build-go.sh",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo build --filter=./packages/* && vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . && bash scripts/go-fmt.sh --write",
    "codegen": "bash scripts/codegen.sh",
    "check": "pnpm lint && pnpm check:roadmap && pnpm check:api-spec && pnpm typecheck && pnpm test && pnpm build && pnpm check:skills && pnpm check:boundaries && pnpm check:codegen && pnpm check:go",
    "check:api-spec": "pnpm --filter @wardlock/api-spec lint",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:roadmap": "node scripts/roadmap-board.mjs --check",
    "roadmap:board": "node scripts/roadmap-board.mjs",
    "check:codegen": "bash scripts/codegen.sh --check",
    "check:go": "bash scripts/check-go.sh",
    "browser:test": "pnpm build && node scripts/browser-acceptance.mjs",
    "docs:build": "pnpm --filter @wardlock/docs-site build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
