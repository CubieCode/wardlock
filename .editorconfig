root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,go.work,Makefile}]
indent_style = tab
indent_size = 4

# Vendored skills stay byte-identical to upstream.
[.agents/skills/vercel-react-best-practices/**]
trim_trailing_whitespace = false
