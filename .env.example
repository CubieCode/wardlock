# Wardlock environment. Copy to .env for local development; Orca worktrees get
# a lane-specific .env from scripts/worktree-setup.sh. Never commit .env.
#
# Only variables marked "read" are used today. "Reserved" variables are
# documented so lanes agree on names; they are not read until the named
# roadmap item lands.

# --- Server (wardlockd): read ---------------------------------------------

# Listen address for plain HTTP: the edge (every site) and the owner API.
WARDLOCK_HTTP_ADDR=127.0.0.1:8080
# Sites are published at <site>.<base domain>. *.localhost resolves to
# loopback, so subdomain routing works locally without DNS.
WARDLOCK_BASE_DOMAIN=wardlock.localhost
# Host serving the dashboard and /api/. Empty means the base domain itself.
# In production prefer a different registrable domain from the sites
# (docs/SECURITY-MODEL.md).
WARDLOCK_DASHBOARD_HOST=
# SQLite database, deploy blobs and, later, certificates. Defaults to
# ./wardlock-data when unset.
WARDLOCK_DATA_DIR=.local/data
# debug, info, warn or error.
WARDLOCK_LOG_LEVEL=info
# json (default) or text.
WARDLOCK_LOG_FORMAT=text
# Outgoing mail (F0.4). dev:// (the default) delivers nothing: it writes each
# message to .local/mail/ as .eml and logs only recipient and subject.
# smtp://user:pass@host:587 requires STARTTLS; smtps://user:pass@host:465 uses
# implicit TLS. Percent-encode special characters in the user and password.
WARDLOCK_SMTP_URL=dev://
# Sender address. Defaults to Wardlock <wardlock@<dashboard host>>.
WARDLOCK_SMTP_FROM=
# Deploy file bodies (C1.2). Defaults to <WARDLOCK_DATA_DIR>/blobs.
WARDLOCK_BLOB_DIR=
# Deploy limits (C1.2), as whole numbers of bytes or files. Defaults: 26214400
# (25 MiB) per file, 20000 files and 1073741824 (1 GiB) per deploy.
WARDLOCK_MAX_FILE_SIZE=
WARDLOCK_MAX_DEPLOY_FILES=
WARDLOCK_MAX_DEPLOY_SIZE=

# --- Development: read ------------------------------------------------------

# Vite dev server port for the dashboard (pnpm dev).
WARDLOCK_WEB_DEV_PORT=5173
# Set by pnpm dev to make wardlockd proxy dashboard pages to Vite. Leave empty.
WARDLOCK_DEV_DASHBOARD_URL=

# --- CLI (wardlock): read ---------------------------------------------------

# Default server for `wardlock version --server`.
WARDLOCK_SERVER=

# --- Reserved: not read yet -------------------------------------------------

# Server key for HMAC token hashes, cookie signing and encryption (C1.1, A2.2).
# At least 32 random bytes, base64url. Changing it invalidates every session
# and share link.
WARDLOCK_SECRET=
# HTTPS listen address for automatic TLS (C1.4).
WARDLOCK_HTTPS_ADDR=127.0.0.1:8443
# Reserved port for a local SMTP catcher. Unused: smtp:// always requires
# STARTTLS with a trusted certificate, so local development uses dev://.
WARDLOCK_DEV_SMTP_PORT=2525
