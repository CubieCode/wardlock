# Wardlock environment. Copy to .env for local development; Orca worktrees get
# a lane-specific .env from scripts/worktree-setup.sh. Never commit .env.
#
# Only variables marked "read" are used today. "Reserved" variables are
# documented so lanes agree on names; they are not read until the named
# roadmap item lands.

# --- Server (wardlockd): read ---------------------------------------------

# Listen address for plain HTTP: the edge (every site) and the owner API.
WARDLOCK_HTTP_ADDR=127.0.0.1:8080
# Operator listener for /healthz, /readyz and Prometheus /metrics, never
# reachable through site or dashboard hosts. Empty (the default) disables it.
# Keep it on loopback or a private network, e.g. 127.0.0.1:9740.
WARDLOCK_OPERATOR_ADDR=
# Sites are published at <site>.<base domain>. *.localhost resolves to
# loopback, so subdomain routing works locally without DNS.
WARDLOCK_BASE_DOMAIN=wardlock.localhost
# Host serving the dashboard and /api/. Empty means the base domain itself.
# In production prefer a different registrable domain from the sites
# (docs/SECURITY-MODEL.md).
WARDLOCK_DASHBOARD_HOST=
# SQLite database, deploy blobs and certificates. Defaults to
# ./wardlock-data when unset.
WARDLOCK_DATA_DIR=.local/data
# debug, info, warn or error.
WARDLOCK_LOG_LEVEL=info
# json (default) or text.
WARDLOCK_LOG_FORMAT=text
# Outgoing mail (F0.4). dev:// (the default) delivers nothing: it writes each
# message to .local/mail/ as .eml and logs only recipient and subject.
# smtp://user:pass@host:587 requires STARTTLS; smtps://user:pass@host:465 uses
# implicit TLS. Percent-encode special characters in the user and password.
WARDLOCK_SMTP_URL=dev://
# Sender address. Defaults to Wardlock <wardlock@<dashboard host>>.
WARDLOCK_SMTP_FROM=
# OAuth and OIDC sign-in for protected sites (A2.5). A provider is on when
# its client ID and secret are both set. Register the redirect URL
# https://auth.<base domain>/callback/<github|google|oidc> with each provider
# (locally http://auth.wardlock.localhost:<port>/callback/...).
WARDLOCK_GITHUB_CLIENT_ID=
WARDLOCK_GITHUB_CLIENT_SECRET=
WARDLOCK_GOOGLE_CLIENT_ID=
WARDLOCK_GOOGLE_CLIENT_SECRET=
# Generic OIDC: the issuer URL, its client, and the button label (default
# "single sign-on").
WARDLOCK_OIDC_ISSUER=
WARDLOCK_OIDC_CLIENT_ID=
WARDLOCK_OIDC_CLIENT_SECRET=
WARDLOCK_OIDC_NAME=
# Where deploy file bodies live: fs (the default) or s3 (C1.11).
WARDLOCK_BLOB_BACKEND=
# fs: the blob directory (C1.2). Defaults to <WARDLOCK_DATA_DIR>/blobs.
WARDLOCK_BLOB_DIR=
# s3: an S3-compatible bucket (docs/DEPLOYMENT.md). The endpoint is the
# service's base URL (https://s3.eu-west-1.amazonaws.com, or a local MinIO at
# http://127.0.0.1:9000); the region is required (auto for Cloudflare R2,
# garage for Garage). The prefix is optional; PATH_STYLE true or false forces
# the addressing style. Credentials come from the standard AWS variables
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN), the shared
# credentials file (AWS_SHARED_CREDENTIALS_FILE, AWS_PROFILE) or a role.
WARDLOCK_S3_ENDPOINT=
WARDLOCK_S3_BUCKET=
WARDLOCK_S3_REGION=
WARDLOCK_S3_PREFIX=
WARDLOCK_S3_PATH_STYLE=
# Blob cache (C1.12): local copies of served files, at most MAX_BYTES of
# them, so the bucket is asked once per file. Off unless both are set; meant
# for s3. The directory must not overlap the blob directory.
WARDLOCK_BLOB_CACHE_DIR=
WARDLOCK_BLOB_CACHE_MAX_BYTES=
# Deploy limits (C1.2), as whole numbers of bytes or files. Defaults: 26214400
# (25 MiB) per file, 20000 files and 1073741824 (1 GiB) per deploy.
WARDLOCK_MAX_FILE_SIZE=
WARDLOCK_MAX_DEPLOY_FILES=
WARDLOCK_MAX_DEPLOY_SIZE=
# Garbage collection (C1.8): minutes between runs inside serve (0 runs none;
# `wardlockd gc` runs one), hours that new uploads and pending deploys are
# protected, and the newest deploys kept per site (the active deploy is
# always kept too). Defaults: 60, 24 and 50.
WARDLOCK_GC_INTERVAL_MINUTES=
WARDLOCK_GC_GRACE_HOURS=
WARDLOCK_DEPLOY_HISTORY=
# Access log (A2.8). Client IPs keep only this many leading bits; 0 stores no
# IP. Defaults: 24 (IPv4 /24) and 48 (IPv6 /48).
WARDLOCK_ACCESS_LOG_IPV4_PREFIX=
WARDLOCK_ACCESS_LOG_IPV6_PREFIX=
# Days to keep access-log entries; 0 keeps them forever. Default 90.
WARDLOCK_ACCESS_LOG_RETENTION_DAYS=
# Entries that may wait for a database write before new ones are dropped
# (and counted). Default 10000.
WARDLOCK_ACCESS_LOG_BUFFER=
# Custom domains (C1.9): comma-separated host:port DNS servers for
# verification lookups, such as 9.9.9.9:53. Empty uses the system resolvers.
WARDLOCK_DNS_RESOLVERS=
# Who may add owners (A2.13): owners (the default; any owner can invite) or
# operator (only `wardlockd admin create`; the invite API answers 403).
WARDLOCK_INVITES=
# Plain address (no display name) that receives abuse reports (A2.13). Set,
# login, "Click to view" and unavailable pages show a "Report this site" link
# to the form at /report on the dashboard host; empty (the default) shows none
# and the form is a 404.
WARDLOCK_ABUSE_EMAIL=

# Server key for HMAC hashes of codes, sessions and tokens, and for site
# cookie signing. Required by `serve` and `admin`: at least 32 random
# bytes, base64url (`openssl rand -base64 32 | tr '+/' '-_'`). Changing it
# signs every owner out and invalidates every share link, API token and site
# session.
WARDLOCK_SECRET=

# TLS (docs/DEPLOYMENT.md "TLS"). local, proxy or auto. Empty means local
# for localhost/*.localhost hosts and proxy otherwise; auto is never implied.
WARDLOCK_TLS_MODE=
# Proxy mode: comma-separated IP addresses or CIDR ranges whose
# X-Forwarded-For and X-Forwarded-Proto are believed (e.g. 127.0.0.1,::1).
WARDLOCK_TRUSTED_PROXIES=
# Auto mode only. HTTPS listen address (default :443; WARDLOCK_HTTP_ADDR
# then defaults to :80). Ignored in other modes.
WARDLOCK_HTTPS_ADDR=127.0.0.1:8443
# Auto mode only: ACME directory (default Let's Encrypt), optional contact,
# optional PEM bundle trusted for the CA itself (a private CA or Pebble).
WARDLOCK_ACME_CA=
WARDLOCK_ACME_EMAIL=
WARDLOCK_ACME_CA_ROOT=
# Auto mode only: DNS-01 provider for the *.<base domain> wildcard,
# cloudflare or desec, and its narrowly scoped API token. Never commit one.
WARDLOCK_DNS_PROVIDER=
WARDLOCK_DNS_API_TOKEN=

# --- Development: read ------------------------------------------------------

# Vite dev server port for the dashboard (pnpm dev).
WARDLOCK_WEB_DEV_PORT=5173
# Set by pnpm dev to make wardlockd proxy dashboard pages to Vite. Leave empty.
WARDLOCK_DEV_DASHBOARD_URL=

# --- CLI (wardlock): read ---------------------------------------------------

# Default server for every CLI command when neither --server nor
# wardlock.json names one.
WARDLOCK_SERVER=

# --- Reserved: not read yet -------------------------------------------------

# Reserved port for a local SMTP catcher. Unused: smtp:// always requires
# STARTTLS with a trusted certificate, so local development uses dev://.
WARDLOCK_DEV_SMTP_PORT=2525
